{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linear Caryotype",
  "version": "0.1.0",
  "identifier": "dev.caryotype.linear",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Linear Caryotype",
        "width": 360,
        "height": 140,
        "minWidth": 320,
        "minHeight": 18,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Linear day runner",
    "longDescription": "Always-on-top panel that turns a Linear backlog into a time-budgeted day with an LLM tray for standups and summaries."
  }
}
